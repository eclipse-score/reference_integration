diff --git a/MODULE.bazel b/MODULE.bazel
index 7fe8318ff..4efb5136f 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -310,3 +310,10 @@ git_override(
     patches = ["//patches:hedron_compile_commands_env_vars.patch"],
     remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
 )
+
+bazel_dep(name = "score_tools", version = "0.0.4", dev_dependency = True)
+
+# SARIF output of the lint aspects (--output_groups=+rules_lint_machine).
+lint_sarif = use_extension("@aspect_rules_lint//lint:extensions.bzl", "toolchains", dev_dependency = True)
+lint_sarif.sarif_parser()
+use_repo(lint_sarif, "sarif_parser_toolchains")
diff --git a/quality/static_analysis/BUILD b/quality/static_analysis/BUILD
new file mode 100644
index 000000000..5f6c08fc7
--- /dev/null
+++ b/quality/static_analysis/BUILD
@@ -0,0 +1,21 @@
+# *******************************************************************************
