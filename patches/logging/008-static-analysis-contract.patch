diff --git a/.bazelrc b/.bazelrc
index e9c3f956..db2e33b9 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -156,3 +156,16 @@ build:banned-functions --host_copt=-Wno-unused-command-line-argument
 # Unified LLVM source-based coverage (C++ + Rust), see quality/coverage/ and
 # @score_coverage. Use: bazel coverage --config=llvm_cov //score/... --build_tests_only
 import %workspace%/quality/coverage/coverage.bazelrc
+
+# Lint with the central S-CORE policies: bazel build --config=lint //...
+build:lint --aspects=//tools/lint:linters.bzl%clang_tidy_aspect,//tools/lint:linters.bzl%ruff_aspect,@score_rust_policies//clippy:linters.bzl%clippy_strict
+build:lint --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
+build:lint --extra_toolchains=@sarif_parser_toolchains//:all
+build:lint --features=-strict_warnings --features=-warnings_as_errors --features=-treat_warnings_as_errors
+build:lint --output_groups=+rules_lint_human
+build:lint --copt=-Wno-unused-command-line-argument --host_copt=-Wno-unused-command-line-argument
+
+# Lint findings as SARIF without failing on them, e.g. for reports and dashboards.
+build:lint_sarif --config=lint
+build:lint_sarif --output_groups=rules_lint_machine
+build:lint_sarif --@aspect_rules_lint//lint:fail_on_violation=false
diff --git a/MODULE.bazel b/MODULE.bazel
index 07e657b8..7981ad81 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -28,7 +28,7 @@ bazel_dep(name = "aspect_rules_lint", version = "2.5.0", dev_dependency = True)
 bazel_dep(name = "score_cpp_policies", version = "0.0.0", dev_dependency = True)
 git_override(
     module_name = "score_cpp_policies",
-    commit = "b6551c217fbb0daf948b493c4ba69eb7fe8359a5",
+    commit = "c8fb812e85a971ac083b28219ce86d3f7a1cf9be",
     remote = "https://github.com/eclipse-score/score_cpp_policies.git",
 )
 
@@ -267,3 +267,10 @@ single_version_override(
     module_name = "grpc-java",
     version = "1.70.0",
 )
+
+bazel_dep(name = "score_tools", version = "0.0.4", dev_dependency = True)
+
+# SARIF output of the lint aspects (--output_groups=+rules_lint_machine).
+lint_sarif = use_extension("@aspect_rules_lint//lint:extensions.bzl", "toolchains", dev_dependency = True)
+lint_sarif.sarif_parser()
+use_repo(lint_sarif, "sarif_parser_toolchains")
