+load("@score_tools//codeql:defs.bzl", "codeql_analysis")
+
+# CodeQL MISRA C++ analysis of a traced build: bazel run //quality/static_analysis:codeql
+codeql_analysis(
+    name = "codeql",
+    targets = ["//score/..."],
+    coding_standards_config = "tools/static_analysis/coding-standards.yaml",
+    exclude_testonly = True,
+    keep_going = True,
+)
