diff --git a/tools/lint/linters.bzl b/tools/lint/linters.bzl
new file mode 100644
index 0000000..5f90df4
--- /dev/null
+++ b/tools/lint/linters.bzl
@@ -0,0 +1,33 @@
+# *******************************************************************************
