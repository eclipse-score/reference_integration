diff --git a/.bazelrc b/.bazelrc
index 158386e..b0c5e21 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -84,3 +84,10 @@ build:arm64-qnx --extra_toolchains=@score_qnx_aarch64_ifs_toolchain//:ifs-aarch6
 test:arm64-qnx --run_under=@score_qnx_unit_tests//src:run_under_qnx
 test:arm64-qnx --test_timeout=300
 test:arm64-qnx --test_lang_filters=cc,rust
+
+# Lint with the central S-CORE policies: bazel build --config=lint //...
+build:lint --aspects=//tools/lint:linters.bzl%clang_tidy_aspect,//tools/lint:linters.bzl%ruff_aspect
+build:lint --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
+build:lint --extra_toolchains=@sarif_parser_toolchains//:all
+build:lint --features=-strict_warnings --features=-warnings_as_errors --features=-treat_warnings_as_errors
+build:lint --output_groups=+rules_lint_human
