+
+// Stub replacing score-persistency's score/kvs/kvs_builder.h for SPP compilation.
+// Only the subset of the API used by factory_mw_impl.cpp is provided.
+
+#ifndef SCORE_LIB_KVS_KVSBUILDER_HPP
+#define SCORE_LIB_KVS_KVSBUILDER_HPP
+
+#include "score/kvs/kvs.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace score::mw::per::kvs
+{
+
+enum class KvsDefaults : std::uint8_t
+{
+    kRequired = 0,
+    kOptional = 1,
+    kIgnored = 2,
+};
+
+enum class KvsLoad : std::uint8_t
+{
+    kRequired = 0,
+    kOptional = 1,
+    kIgnored = 2,
+};
+
+/// @brief Stub KvsBuilder — build() always returns an empty (failure) Result.
+class KvsBuilder final
+{
+  public:
+    explicit KvsBuilder(const InstanceId& /*instance_id*/) {}
+
+    KvsBuilder& Defaults(const KvsDefaults& /*mode*/) noexcept
+    {
+        return *this;
+    }
+    KvsBuilder& KvsLoad(const score::mw::per::kvs::KvsLoad& /*mode*/) noexcept
+    {
+        return *this;
+    }
+    KvsBuilder& WorkingDir(const std::string& /*working_dir*/) noexcept
+    {
+        return *this;
+    }
+
+    score::Result<std::unique_ptr<Kvs>> build() noexcept
+    {
+        return score::Result<std::unique_ptr<Kvs>>{std::make_unique<Kvs>()};
+    }
+};
+
+}  // namespace score::mw::per::kvs
+
+#endif  // SCORE_LIB_KVS_KVSBUILDER_HPP
