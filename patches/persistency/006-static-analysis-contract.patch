+# terms of the Apache License Version 2.0 which is available at
+# https://www.apache.org/licenses/LICENSE-2.0
+#
+# SPDX-License-Identifier: Apache-2.0
+# *******************************************************************************
+load("@score_tools//codeql:defs.bzl", "codeql_analysis")
+
+# CodeQL MISRA C++ analysis of a traced build: bazel run //quality/static_analysis:codeql
+codeql_analysis(
+    name = "codeql",
+    targets = ["//score/kvs/..."],
+    coding_standards_config = "coding-standards.yaml",
+    exclude_testonly = True,
+    keep_going = True,
+)
diff --git a/score.bazelrc/score_lint.bazelrc b/score.bazelrc/score_lint.bazelrc
index 48387419..4d0c73d7 100644
--- a/score.bazelrc/score_lint.bazelrc
+++ b/score.bazelrc/score_lint.bazelrc
@@ -42,3 +42,9 @@ build:lint --config=score-linux-x86_64
 build:lint --config=clang-tidy
 build:lint --config=clippy
 build:lint --config=ruff
+build:lint --extra_toolchains=@sarif_parser_toolchains//:all
+
+# Lint findings as SARIF without failing on them, e.g. for reports and dashboards.
+build:lint_sarif --config=lint
+build:lint_sarif --output_groups=rules_lint_machine
+build:lint_sarif --@aspect_rules_lint//lint:fail_on_violation=false
