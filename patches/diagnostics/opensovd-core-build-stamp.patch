# The Bazel sandbox has no Git metadata. Stamp the OpenSOVD revision and its
# commit date, not the integration revision or the time of the image build.
# Keep both values in sync with the opensovd_core override in MODULE.bazel.
diff --git a/opensovd-cli/gateway/BUILD.bazel b/opensovd-cli/gateway/BUILD.bazel
--- a/opensovd-cli/gateway/BUILD.bazel
+++ b/opensovd-cli/gateway/BUILD.bazel
@@ -9,6 +9,10 @@ exports_files(["Cargo.toml"])
 workspace_cargo_build_script(
     name = "build_script_build",
     srcs = ["build.rs"],
+    build_script_env = {
+        "OPENSOVD_COMMIT_SHA": "f61eeeb4133e5c5a7c3541861489f12e306e4ee4",
+        "SOURCE_DATE_EPOCH": "1795533937",  # 2026-11-24T15:25:37Z
+    },
     crate_name = "build_script_build",
     crate_root = "build.rs",
     pkg_name = "opensovd-gateway",
