#
# Rationale: The CDA's SOVD interface was returning resources without identifiers,
# which violates the SOVD specification requirement that all resources must have
# unique IDs. This patch populates the 'id' field from the 'href' to ensure
# spec-compliant responses and proper resource discovery by SOVD clients.
# Required for SOVD API compliance and release clearance.
#
diff --git a/cda-sovd/src/sovd.rs b/cda-sovd/src/sovd.rs
--- a/cda-sovd/src/sovd.rs
+++ b/cda-sovd/src/sovd.rs
@@ -649,4 +649,4 @@
         .map(|(name, href)| sovd_interfaces::Resource {
             name: name.to_string(),
             href: format!("{base_path}/{}", href.unwrap_or(name)),
-            id: None,
+            id: Some(href.unwrap_or(name).to_owned()),
         })
