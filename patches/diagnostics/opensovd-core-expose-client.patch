#
# Rationale: The opensovd-client library is an internal component of opensovd-core
# but is needed by external projects building custom SOVD clients. This patch
# exposes the opensovd_client target with public visibility to enable reuse
# without duplicating the client implementation. Required for modular build
# architecture and avoiding code duplication.
#
diff --git a/opensovd-client/BUILD.bazel b/opensovd-client/BUILD.bazel
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/opensovd-client/BUILD.bazel
@@ -0,0 +1,29 @@
+load("//bazel:rust_crate.bzl", "workspace_rust_library")
+
+package(default_visibility = ["//:workspace_crates"])
+
+exports_files(["Cargo.toml"])
+
+workspace_rust_library(
+    name = "opensovd_client",
+    srcs = glob(["src/**/*.rs"]),
+    crate_deps = [
+        "bytes",
+        "http",
+        "http-body",
+        "http-body-util",
+        "hyper",
+        "hyper-util",
+        "percent-encoding",
+        "serde",
+        "serde_json",
+        "thiserror",
+        "tokio",
+        "tower",
+        "tower-service",
+    ],
+    crate_name = "opensovd_client",
+    crate_root = "src/lib.rs",
+    compile_data = ["README.md"],
+    deps = ["//opensovd-models:opensovd_models"],
+)
