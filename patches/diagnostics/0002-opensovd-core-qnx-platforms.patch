# Generate Cargo dependency cfgs matching the S-CORE QNX platform constraints.
# Upstream: https://github.com/eclipse-opensovd/opensovd-core/pull/304
# Standalone prerequisite: https://github.com/bazelbuild/rules_rust/pull/4469
diff --git a/MODULE.bazel b/MODULE.bazel
index 45d47ee..0ef5d60 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -37,5 +37,16 @@ opensovd_crate_universe.from_cargo(
     cargo_lockfile = "//:Cargo.lock",
     manifests = ["//:Cargo.toml"],
     skip_cargo_lockfile_overwrite = True,
+    supported_platform_triples = [
+        "aarch64-apple-darwin",
+        "aarch64-unknown-linux-gnu",
+        "aarch64-unknown-nto-qnx710",
+        "wasm32-unknown-unknown",
+        "wasm32-wasip1",
+        "x86_64-pc-nto-qnx710",
+        "x86_64-pc-windows-msvc",
+        "x86_64-unknown-linux-gnu",
+        "x86_64-unknown-nixos-gnu",
+    ],
 )
 use_repo(opensovd_crate_universe, "crate_index")
