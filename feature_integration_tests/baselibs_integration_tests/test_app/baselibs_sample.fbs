// Minimal FlatBuffers schema for the baselibs flatbuffers feature test. A keyed
// `Item` table lets the generated code build a sorted vector and look items up
// by key, which exercises the schema-generated C++ API end-to-end.

namespace score.ri.baselibs_sample;

table Item {
  id:int (key);
  label:string;
}

table Container {
  items:[Item];
}

root_type Container;
