load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@score_lifecycle//:defs.bzl", "launch_manager_config")

# The network configuration of the Raspberry Pi images is generated by the repository rule in
# repo.bzl, as @score_pi_network. See README.md.
exports_files(["repo.bzl"])

# The diagnostics of the showcase with the address of the image instead of 0.0.0.0, see README.md:
# the CDA configuration with the address and subnet of the image as the DoIP tester address, and the
# launch manager configuration with the gateway listening on the address of the image. Each fails if
# there is nothing to replace.
genrule(
    name = "cda_config",
    srcs = [
        "//showcases/diagnostics:cda_config",
        "@score_pi_network//:diagnostics/cda.sed",
    ],
    outs = ["diagnostics/opensovd-cda.toml"],
    cmd = " && ".join([
        "sed -f $(location @score_pi_network//:diagnostics/cda.sed) $(location //showcases/diagnostics:cda_config) > $@",
        "[ \"$$(grep -c '^tester_address = \"0.0.0.0\"$$' $@)\" = 0 ]",
        "[ \"$$(grep -c '^tester_address = ' $@)\" = 1 ]",
        "[ \"$$(grep -c '^tester_subnet = ' $@)\" = 1 ]",
    ]),
)

genrule(
    name = "launch_manager_json",
    srcs = [
        "//showcases/diagnostics:launch_manager_config.json",
        "@score_pi_network//:diagnostics/gateway.sed",
    ],
    outs = ["diagnostics/launch_manager_config.json"],
    cmd = " && ".join([
        "sed -f $(location @score_pi_network//:diagnostics/gateway.sed) $(location //showcases/diagnostics:launch_manager_config.json) > $@",
        "[ \"$$(grep -c '\"SOVD_URL\": \"http://0.0.0.0:' $@)\" = 0 ]",
        "[ \"$$(grep -c '\"SOVD_URL\": ' $@)\" = 1 ]",
        "[ \"$$(grep -c '\"SOVD_MDNS\": ' $@)\" -le 1 ]",
    ]),
)

launch_manager_config(
    name = "launch_manager_config",
    config = "diagnostics/launch_manager_config.json",
)

# Deployed after the showcases, in the place of their configuration.
pkg_tar(
    name = "cda_config_tar",
    srcs = [":cda_config"],
    mode = "0755",
    package_dir = "/showcases/data/diagnostics",
)

pkg_tar(
    name = "launch_manager_config_tar",
    srcs = [":launch_manager_config_lm_bin"],
    mode = "0755",
    package_dir = "/showcases/data/diagnostics/etc",
)

pkg_tar(
    name = "diagnostics_config_tar",
    visibility = ["//images:__subpackages__"],
    deps = [
        ":cda_config_tar",
        ":launch_manager_config_tar",
    ],
)
