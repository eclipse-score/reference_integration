"""The static network configuration of the Raspberry Pi images, set at build time.

The values come from environment variables, so that changing them rebuilds the two files that
hold them and the images, but not the platform (a Bazel flag would change the configuration of
every target). See README.md.
"""

DEFAULT_ADDRESS = "192.168.7.2/24"
DEFAULT_GATEWAY = "192.168.7.1"
DEFAULT_DNS = "8.8.8.8"

_NETIFD = """\
# Generated by //images/network: the static address of the image, set at build time.
config device
    option name     lo
    option ipv6     0

config interface loopback
    option device   lo
    option proto    static
    option ipaddr   127.0.0.1
    option netmask  255.0.0.0

config device
    option type  bridge
    option name  br0
    list ports  eth0
    option ipv6  0

config interface lan
    option device   br0
    option proto    static
    option ipaddr   {address}
{gateway}{dns}"""

_NETWORK_MANAGER = """\
# Generated by //images/network: the static address of the image, set at build time.
[connection]
id=score-static
type=ethernet
interface-name=eth0
autoconnect=true
autoconnect-priority=100

[ethernet]

[ipv4]
method=manual
address1={address}{gateway}
dns={dns}

[ipv6]
method=disabled
"""

def _is_ipv4(value):
    parts = value.split(".")
    if len(parts) != 4:
        return False
    for part in parts:
        if not part.isdigit() or len(part) > 3 or int(part) > 255:
            return False
    return True

def _netmask(prefix):
    bits = (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF
    return ".".join([str((bits >> shift) & 255) for shift in [24, 16, 8, 0]])

# The CDA uses the image address for discovery. The development gateway is restricted to loopback.
_CDA_SED = """\
s|^tester_address = .*|tester_address = "{address}"|
s|^tester_subnet = .*|tester_subnet = "{subnet}"|
"""

_GATEWAY_SED = """\
s|"SOVD_URL": "http://[^:"]*:\\([0-9]*\\)/|"SOVD_URL": "http://127.0.0.1:\\1/|
"""

def _check_address(address):
    parts = address.split("/")
    if len(parts) != 2 or not _is_ipv4(parts[0]) or not parts[1].isdigit() or int(parts[1]) < 1 or int(parts[1]) > 32:
        fail("SCORE_PI_ADDRESS must be an IPv4 address with a prefix length, like 192.168.7.2/24, not '%s'" % address)

def _pi_network_impl(rctx):
    address = rctx.getenv("SCORE_PI_ADDRESS", DEFAULT_ADDRESS)
    gateway = rctx.getenv("SCORE_PI_GATEWAY", DEFAULT_GATEWAY)
    dns = [d.strip() for d in rctx.getenv("SCORE_PI_DNS", DEFAULT_DNS).split(",") if d.strip()]
    _check_address(address)
    if gateway and not _is_ipv4(gateway):
        fail("SCORE_PI_GATEWAY must be an IPv4 address or empty, not '%s'" % gateway)
    for server in dns:
        if not _is_ipv4(server):
            fail("SCORE_PI_DNS must be a comma separated list of IPv4 addresses, not '%s'" % server)

    rctx.file("netifd/network", _NETIFD.format(
        address = address,
        gateway = "    option gateway  %s\n" % gateway if gateway else "",
        dns = "".join(["    list dns        %s\n" % d for d in dns]),
    ))
    rctx.file("networkmanager/score-static.nmconnection", _NETWORK_MANAGER.format(
        address = address,
        gateway = "," + gateway if gateway else "",
        dns = "".join([d + ";" for d in dns]),
    ))
    host, prefix = address.split("/")
    rctx.file("diagnostics/cda.sed", _CDA_SED.format(address = host, subnet = _netmask(int(prefix))))
    rctx.file("diagnostics/gateway.sed", _GATEWAY_SED)
    rctx.file("BUILD.bazel", """\
exports_files([
    "diagnostics/cda.sed",
    "diagnostics/gateway.sed",
    "netifd/network",
    "networkmanager/score-static.nmconnection",
])
""")

pi_network = repository_rule(
    implementation = _pi_network_impl,
    environ = ["SCORE_PI_ADDRESS", "SCORE_PI_GATEWAY", "SCORE_PI_DNS"],
    doc = "The network configuration files of the Raspberry Pi images and the addresses of the diagnostics, from SCORE_PI_ADDRESS, SCORE_PI_GATEWAY and SCORE_PI_DNS.",
)
