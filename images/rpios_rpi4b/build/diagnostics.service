# The diagnostics stack (CDA and OpenSOVD gateway) at boot, see /showcases/data/diagnostics/service.sh.
[Unit]
Description=S-CORE diagnostics stack (classic diagnostic adapter and OpenSOVD gateway)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/showcases/data/diagnostics/service.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
