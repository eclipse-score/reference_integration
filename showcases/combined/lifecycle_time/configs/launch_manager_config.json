{
    "schema_version": 2,
    "defaults": {
        "deployment_config": {
            "bin_dir": "/showcases/bin/",
            "activation_retry_attempts": 1,
            "activation_retry_delay_ms": 500,
            "sandbox": {
                "uid": 0,
                "gid": 0,
                "supplementary_group_ids": [],
                "scheduling_policy": "SCHED_OTHER",
                "scheduling_priority": 1
            }
        },
        "component_properties": {
            "application_profile": {
                "application_type": "Reporting",
                "is_self_terminating": false,
                "alive_supervision": {
                    "min_indications": 0
                }
            },
            "depends_on": [],
            "process_arguments": [],
            "ready_condition": {
                "process_state": "Running"
            }
        },
        "run_target": {
            "transition_timeout_ms": 5000,
            "recovery_action": {
                "switch_run_target": {
                    "run_target": "fallback_run_target"
                }
            }
        },
        "alive_supervision": {
            "evaluation_cycle_ms": 500
        }
    },
    "components": {
        "state_manager": {
            "description": "State Manager application",
            "component_properties": {
                "binary_name": "control_daemon",
                "application_profile": {
                    "application_type": "State_Manager"
                },
                "depends_on": []
            },
            "deployment_config": {
                "working_dir": "/showcases/data/lifecycle_time"
            }
        },
        "vehicle_time": {
            "description": "Vehicle time reporter managed by lifecycle",
            "component_properties": {
                "binary_name": "vehicle_time",
                "application_profile": {
                    "application_type": "Native",
                    "is_self_terminating": false
                },
                "depends_on": ["state_manager"]
            },
            "deployment_config": {
                "shutdown_timeout_ms": 2000
            }
        }
    },
    "run_targets": {
        "Startup": {
            "description": "Lifecycle-managed time reporting showcase",
            "depends_on": ["vehicle_time", "state_manager"],
            "recovery_action": {
                "switch_run_target": {
                    "run_target": "fallback_run_target"
                }
            }
        }
    },
    "initial_run_target": "Startup",
    "fallback_run_target": {
        "description": "Switching off everything",
        "depends_on": ["state_manager"],
        "transition_timeout_ms": 1500
    },
    "alive_supervision": {
        "evaluation_cycle_ms": 500
    }
}
