{
    "schema_version": 1,
    "defaults": {
        "deployment_config": {
            "bin_dir": "/showcases/bin/",
            "ready_recovery_action": {
                "restart": {
                    "number_of_attempts": 1,
                    "delay_before_restart": 0.5
                }
            },
            "sandbox": {
                "uid": 0,
                "gid": 0,
                "supplementary_group_ids": [],
                "scheduling_policy": "SCHED_OTHER",
                "scheduling_priority": 1
            }
        },
        "component_properties": {
            "application_profile": {
                "application_type": "Reporting",
                "is_self_terminating": false,
                "alive_supervision": {
                    "min_indications": 0
                }
            },
            "depends_on": [],
            "process_arguments": [],
            "ready_condition": {
                "process_state": "Running"
            }
        },
        "run_target": {
            "transition_timeout": 5,
            "recovery_action": {
                "switch_run_target": {
                    "run_target": "fallback_run_target"
                }
            }
        },
        "alive_supervision": {
            "evaluation_cycle": 0.5
        }
    },
    "components": {
        "state_manager": {
            "description": "State Manager application",
            "component_properties": {
                "binary_name": "control_daemon",
                "application_profile": {
                    "application_type": "State_Manager"
                },
                "depends_on": []
            }
        },
        "vehicle_time": {
            "description": "Vehicle time reporter managed by lifecycle",
            "component_properties": {
                "binary_name": "vehicle_time",
                "application_profile": {
                    "application_type": "Native",
                    "is_self_terminating": false
                },
                "depends_on": ["state_manager"]
            },
            "deployment_config": {
                "shutdown_timeout": 2.0
            }
        },
        "com_api_example": {
            "description": "Communication API example managed by lifecycle",
            "component_properties": {
                "binary_name": "com-api-example",
                "application_profile": {
                    "application_type": "Native",
                    "is_self_terminating": false
                },
                "process_arguments": [
                    "-s",
                    "/showcases/data/lifecycle_time_comm/etc/mw_com_config.json"
                ],
                "depends_on": ["state_manager"]
            },
            "deployment_config": {
                "working_dir": "/showcases/data/lifecycle_time_comm"
            }
        }
    },
    "run_targets": {
        "Startup": {
            "description": "Lifecycle-managed time and communication showcase",
            "depends_on": ["vehicle_time", "com_api_example", "state_manager"],
            "recovery_action": {
                "switch_run_target": {
                    "run_target": "fallback_run_target"
                }
            }
        }
    },
    "initial_run_target": "Startup",
    "fallback_run_target": {
        "description": "Switching off everything",
        "depends_on": ["state_manager"],
        "transition_timeout": 1.5
    },
    "alive_supervision": {
        "evaluation_cycle": 0.5
    }
}
