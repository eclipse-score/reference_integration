[
    {
        "name": "Platform Version Check",
        "description": "A consumer must find the platform info service deployed by the platform and receive the S-CORE version it was built for",
        "apps": [
            {
                "path": "/bin/sh",
                "args": [
                    "-c",
                    "cd /usr/bin/platform_info && ./platform_info_service >/dev/null 2>&1 &"
                ],
                "env": {}
            },
            {
                "path": "/showcases/bin/platform_info_consumer",
                "args": [
                    "--service_instance_manifest",
                    "/usr/bin/platform_info/etc/mw_com_config.json"
                ],
                "env": {}
            }
        ]
    }
]
