{
    "name": "Communication Sender Receiver Example",
    "description": "Runs the producer and consumer as separate processes to demonstrate inter-process communication",
    "apps":[
        {
            "path": "/showcases/bin/producer_app",
            "args": [
                "-s", "/showcases/data/comm/etc/mw_com_config.json"
            ],
            "env": {},
            "dir": "/showcases/data/comm"
        },
        {
            "path": "/showcases/bin/consumer_app",
            "args": [
                "-s", "/showcases/data/comm/etc/mw_com_config.json"
            ],
            "env": {},
            "dir": "/showcases/data/comm",
            "delay": 1
        }
    ]
}
