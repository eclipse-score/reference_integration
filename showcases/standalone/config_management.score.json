{
    "name": "Config Management Daemon Example",
    "description": "Example for running the config management daemon with demo parameters. Example takes ~10s",
    "apps": [
        {
            "path": "/showcases/bin/config_daemon",
            "args": [
                "-s", "/showcases/data/config_management/etc/mw_com_config.json"
            ],
            "env": {},
            "dir": "/showcases/data/config_management"
        },
        {
            "path": "/showcases/bin/lifecycle_signal.sh",
            "args": ["config_daemon", "SIGTERM"],
            "env": {},
            "delay": 10
        }
    ]
}
