#
# Module-specific Bazel flags for score_config_management.
#
# These flags name labels inside @score_config_management, so they can only be
# resolved while that module is part of the integration. Keeping them here rather than
# in the root .bazelrc means they disappear together with the module when it is
# disabled in known_good.json - a --@score_config_management//... flag for an absent
# module would otherwise break every bazel invocation, including 'bazel query'.
#
# Imported via bazel_common/module_flags.bazelrc, which is generated from
# known_good.json. Do not import this file directly.

build:_common --@score_config_management//score/config_management/config_daemon/code:score_variant=true
