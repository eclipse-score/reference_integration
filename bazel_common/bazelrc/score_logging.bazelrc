#
# Module-specific Bazel flags for score_logging.
#
# These flags name labels inside @score_logging, so they can only be resolved while
# that module is part of the integration. Keeping them here rather than in the root
# .bazelrc means they disappear together with the module when it is disabled in
# known_good.json - a --@score_logging//... flag for an absent module would otherwise
# break every bazel invocation, including 'bazel query'.
#
# Imported via bazel_common/module_flags.bazelrc, which is generated from
# known_good.json. Do not import this file directly.

# Flags needed by datarouter
build:_common --@score_logging//score/datarouter/build_configuration_flags:enable_nonverbose_dlt=False
build:_common --@score_logging//score/datarouter/build_configuration_flags:enable_dynamic_configuration=False
build:_common --@score_logging//score/datarouter/build_configuration_flags:file_transfer=False
build:_common --@score_logging//score/datarouter/build_configuration_flags:use_local_vlan=True
build:_common --@score_logging//score/datarouter/build_configuration_flags:dlt_output_enable=True

# Persistency-specific coverage config (see rust_coverage_config of score_persistency
# in known_good.json). The flag belongs to score_logging, so it lives here.
build:ferrocene-coverage-per --@score_logging//score/mw/log/flags:KRemote_Logging=False
