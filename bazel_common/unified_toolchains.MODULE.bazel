# Toolchain definitions of the unified config (unified.bazelrc registers them). Toolchains are
# defined by module extension tags, which no flag can set, so scripts/module_tests.py includes this
# file in every tested module's MODULE.bazel too. The unified_ prefix keeps the repos apart from a
# module's own definitions, which often reuse ref_int's names with other settings.
unified_gcc = use_extension("@score_bazel_cpp_toolchains//extensions:gcc.bzl", "gcc", dev_dependency = True)
unified_gcc.toolchain(
    name = "unified_gcc_x86_64_toolchain",
    target_cpu = "x86_64",
    target_os = "linux",
    use_default_package = True,
    version = "12.2.0",
)
use_repo(unified_gcc, "unified_gcc_x86_64_toolchain")

# score_docs_as_code@36cdc3f pulls score_devcontainer@1.11.1, which got yanked. Lives here as it is the
# only file included by ref_int and by every tested module alike. Drop with the next docs_as_code bump.
single_version_override(
    module_name = "score_devcontainer",
    version = "1.11.2",
)
