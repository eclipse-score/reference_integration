{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclipse.dev/score/schemas/srac/0.1/srac.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Draft S-CORE Safety Relevance Assertion Capability profile",
  "description": "Experimental profile for the SRAC sidecar proof of concept. This is not an approved S-CORE specification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assertionId", "subject", "safetyRelevance", "rationale", "evidence", "assertion"],
  "properties": {
    "schemaVersion": {"const": "0.1-draft"},
    "assertionId": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purl", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "purl": {"type": "string", "pattern": "^pkg:"},
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "format": "uri"},
        "componentPath": {"type": "string", "minLength": 1}
      }
    },
    "safetyRelevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classification"],
      "properties": {
        "status": {"enum": ["safety-related", "not-safety-related", "undetermined"]},
        "classification": {"enum": ["QM", "ASIL-A", "ASIL-B", "ASIL-C", "ASIL-D", "not-assigned"]}
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/reference"}, "uniqueItems": true},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference"}
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "author", "created"],
      "properties": {
        "status": {"enum": ["draft", "under-review", "reviewed", "approved", "superseded", "withdrawn"]},
        "author": {"$ref": "#/$defs/party"},
        "reviewer": {"anyOf": [{"$ref": "#/$defs/party"}, {"type": "null"}]},
        "created": {"type": "string", "format": "date-time"},
        "updated": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "uri"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
